# Credenciales y acceso a la VM de build (VirtualBox, Windows).
# Copia este archivo a vm-config.env y completa los valores reales.
# vm-config.env esta en .gitignore: NO subir credenciales reales.

# Alias definido en ~/.ssh/config (si lo tenes). Si no, se usa VM_USER@VM_HOST.
VM_SSH_ALIAS=vmwin

# IP de la VM en la red del cable y usuario con acceso SSH (clave publica).
VM_HOST=192.168.100.120
VM_USER=admin

# Password de la cuenta Windows de la VM (solo referencia; el SSH usa clave).
VM_PASS=cambia-esta-password

# Rutas dentro de la VM.
VM_BUILD_DIR=C:/build
VM_SRC_DIR="C:/build/Project Reboot 3.0"
VM_OUT_DIR=C:/build/out